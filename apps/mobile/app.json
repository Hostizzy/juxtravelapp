{
  "expo": {
    "name": "JuxTravel",
    "slug": "mobile",
    "version": "1.0.0",
    "scheme": [
      "juxtravel",
      "juxtravelapp"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.juxtravel.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A6B5A"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-video",
      "expo-web-browser",
      "expo-font",
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "ff5f3d87-3302-4166-a3d0-9efb29818151"
      }
    }
  }
}
